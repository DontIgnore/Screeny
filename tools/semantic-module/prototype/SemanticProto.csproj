<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike prototype for the semantic search module (not part of Screeny.sln). Same runtime setup as the app:
       only the managed ONNX Runtime package; the native onnxruntime.dll is loaded from a folder (OrtRuntime.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SemanticProto</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="[1.31.0]" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>
</Project>
