<Application x:Class="Screeny.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:l="clr-namespace:Screeny.Localization"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Палитра первой: ThemeManager подменяет её на Light.xaml по системной теме -->
        <ResourceDictionary Source="Themes/Dark.xaml"/>
        <ResourceDictionary Source="Themes/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

      <tb:TaskbarIcon x:Key="TrayIcon" IconSource="/Assets/screeny.ico" ToolTipText="Screeny"
                      LeftClickCommand="{Binding CaptureCommand}" NoLeftClickDelay="True">
        <tb:TaskbarIcon.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:Loc Tray.Capture}" Command="{Binding CaptureCommand}" InputGestureText="{Binding HotkeyText}"/>
            <!-- Без функции «История» пунктов нет -->
            <MenuItem Header="{l:Loc Tray.History}" Command="{Binding HistoryCommand}"
                      Visibility="{Binding HistoryFeatureOn, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Header="{l:Loc Tray.OpenHistoryFolder}" Command="{Binding OpenFolderCommand}"
                      Visibility="{Binding HistoryFeatureOn, Converter={StaticResource BoolToVisibility}}"/>
            <Separator/>
            <MenuItem Header="{l:Loc Tray.Settings}" Command="{Binding SettingsCommand}"/>
            <MenuItem Header="{l:Loc Common.CheckConflicts}" Command="{Binding SetupWizardCommand}"/>
            <MenuItem Header="{l:Loc Tray.CheckUpdates}" Command="{Binding CheckUpdatesCommand}"/>
            <Separator/>
            <MenuItem Header="{l:Loc Tray.Exit}" Command="{Binding ExitCommand}"/>
          </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
      </tb:TaskbarIcon>
    </ResourceDictionary>
  </Application.Resources>
</Application>
