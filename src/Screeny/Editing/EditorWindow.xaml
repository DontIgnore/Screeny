<t:ChromeWindow x:Class="Screeny.Editing.EditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:l="clr-namespace:Screeny.Localization"
                xmlns:t="clr-namespace:Screeny.Themes"
                xmlns:ov="clr-namespace:Screeny.Overlay"
                xmlns:ann="clr-namespace:Screeny.Annotations"
                Title="{l:Loc Editor.Title}" Width="1180" Height="800" MinWidth="760" MinHeight="480" ResizeMode="CanResize"
                WindowStartupLocation="CenterScreen" Icon="/Assets/screeny.ico">
  <Window.Resources>
    <!-- “Original / With marks” toggle segment -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink70}"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <!-- Plaques over canvas: always dark, like toolbar -->
    <Style x:Key="Plaque" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Overlay.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Overlay.ShotRing}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style x:Key="PlaqueButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Overlay.Ink}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource Overlay.Hover}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Overlay.Pressed}"/></Trigger>
              <Trigger Property="Tag" Value="Accent"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <t:ChromeWindow.CaptionContent>
    <StackPanel Orientation="Horizontal">
      <!-- Only if entry has original without marks -->
      <Border x:Name="ModeSwitch" CornerRadius="8" Padding="2" Margin="0,0,8,0" BorderThickness="1"
              Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="OriginalMode" GroupName="EditorMode" Style="{StaticResource Segment}" Content="{l:Loc Editor.Original}"
                       ToolTip="{l:Loc Editor.OriginalTip}" Checked="OnModeChecked"/>
          <RadioButton x:Name="MarkedMode" GroupName="EditorMode" Style="{StaticResource Segment}" Content="{l:Loc Editor.WithMarkup}"
                       IsChecked="True" Checked="OnModeChecked"/>
        </StackPanel>
      </Border>
      <Button x:Name="ClearButton" Style="{StaticResource CaptionAction}" Content="{l:Loc Editor.Clear}"
              ToolTip="{l:Loc Editor.ClearTip}" Click="OnClearAnnotations"/>
    </StackPanel>
  </t:ChromeWindow.CaptionContent>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="Viewport" ClipToBounds="True" Background="{DynamicResource Brush.Thumb}">
      <!-- Layers in screenshot pixels; scale and offset (zoom, pan) set in code-behind -->
      <Canvas x:Name="PixelCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Canvas.RenderTransform><MatrixTransform x:Name="ViewTransform"/></Canvas.RenderTransform>
        <Image x:Name="BaseImage" Stretch="None"/>
        <ann:AnnotationLayer x:Name="Annotations"/>
        <ov:RulerLayer x:Name="RulerOverlay"/>
        <!-- Snap guides: only during gesture, not in document or export -->
        <ov:SnapGuideLayer x:Name="SnapGuides"/>
      </Canvas>
      <!-- HUD in DIP over screenshot -->
      <Canvas x:Name="Hud">
        <ov:MagnifierControl x:Name="Magnifier" IsHitTestVisible="False" Visibility="Collapsed"/>
        <!-- Text tool input field; font and size match TextAnnotation -->
        <TextBox x:Name="TextEditor" Visibility="Collapsed" MinWidth="40" Padding="0" BorderThickness="1"
                 BorderBrush="#AAFFFFFF" Background="#33000000" CaretBrush="White"
                 FontFamily="Segoe UI" FontWeight="SemiBold" AcceptsReturn="True" Cursor="IBeam"/>
      </Canvas>

      <!-- Hint: no original, marks not read, “Original” mode -->
      <Border x:Name="Notice" Style="{StaticResource Plaque}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,12,16,0"
              MaxWidth="760" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="NoticeClose" DockPanel.Dock="Right" Style="{StaticResource PlaqueButton}" Content="&#xE711;"
                  FontFamily="{DynamicResource Font.Icon}" FontSize="10" Padding="7,0" ToolTip="{l:Loc Editor.Hide}" Click="OnNoticeClose"/>
          <Button x:Name="RestartButton" DockPanel.Dock="Right" Style="{StaticResource PlaqueButton}" Tag="Accent"
                  Content="{l:Loc Editor.Restart}" Click="OnRestartFromOriginal"/>
          <TextBlock x:Name="NoticeText" Foreground="{DynamicResource Overlay.Ink}" FontFamily="{DynamicResource Font.UI}" FontSize="12.5"
                     TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="18"/>
        </DockPanel>
      </Border>

      <!-- Action result: “Copied · new history entry” -->
      <Border x:Name="Toast" Style="{StaticResource Plaque}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64"
              Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Overlay.Ink}" FontFamily="{DynamicResource Font.UI}" FontSize="12.5"/>
      </Border>

      <!-- Zoom; click — fit / 100% -->
      <Border x:Name="ZoomBadge" Style="{StaticResource Plaque}" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
              Cursor="Hand" ToolTip="{l:Loc Editor.ZoomTip}"
              MouseLeftButtonUp="OnZoomBadgeClick">
        <TextBlock x:Name="ZoomText" Foreground="{DynamicResource Overlay.Ink}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"/>
      </Border>

    </Grid>

    <Border Grid.Row="1" Padding="12,10" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0">
      <!-- On narrow window panel shrinks as whole, not clipped -->
      <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center">
        <ov:ToolbarControl x:Name="Toolbar"/>
      </Viewbox>
    </Border>

    <!-- Options flyouts (near panel buttons and next to selected shape): over canvas and panel -->
    <Canvas x:Name="FlyoutLayer" Grid.RowSpan="2" ClipToBounds="True"/>
  </Grid>
</t:ChromeWindow>
