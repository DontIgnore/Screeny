<Window x:Class="Screeny.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Screeny.Localization"
        xmlns:local="clr-namespace:Screeny.Overlay"
        xmlns:ann="clr-namespace:Screeny.Annotations"
        Title="Screeny Overlay"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Black"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" Cursor="Cross"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowActivated="True"
        Left="0" Top="0" Width="1" Height="1">
  <Window.Resources>
    <!-- Кнопки плашки кода: как на панели, без фокуса (клавиатура остаётся у оверлея) -->
    <Style x:Key="HudButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Overlay.Ink}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource Overlay.Hover}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Overlay.Pressed}"/></Trigger>
              <Trigger Property="Tag" Value="Accent"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <!-- Все слои внутри PixelCanvas рисуются в пикселях снимка; масштаб 1/dpi задаётся в code-behind -->
    <Canvas x:Name="PixelCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas.RenderTransform><ScaleTransform x:Name="PixelScale"/></Canvas.RenderTransform>
      <Image x:Name="ShotImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      <ann:AnnotationLayer x:Name="Annotations"/>
      <local:DimLayer x:Name="Dim"/>
      <!-- Временное измерение линейки: не в документе и не в экспорте -->
      <local:RulerLayer x:Name="RulerOverlay"/>
      <!-- Режим текста (Ctrl+T): подсветка найденных слов и выделения -->
      <local:TextLayer x:Name="TextOverlay"/>
      <!-- Направляющие прилипания фигур и рамки: только на время жеста, не в документе и не в экспорте -->
      <local:SnapGuideLayer x:Name="SnapGuides"/>
    </Canvas>
    <!-- HUD в DIP: размер, лупа, панель инструментов -->
    <Canvas x:Name="Hud">
      <!-- Размер выделения; ✨ — оформление включено (применится к результату, вокруг выделения ничего не рисуется) -->
      <Border x:Name="SizeLabel" Background="#CC202020" CornerRadius="4" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
          <Path x:Name="BeautifyMark" Visibility="Collapsed" Fill="#FFFFD66B" Width="11" Height="11" Stretch="Uniform" Margin="5,0,0,0" VerticalAlignment="Center"
                Data="M7,2 C7.5,6 9,7.5 13,8 C9,8.5 7.5,10 7,14 C6.5,10 5,8.5 1,8 C5,7.5 6.5,6 7,2 Z M13,0.5 C13.2,2 13.8,2.6 15.5,2.8 C13.8,3 13.2,3.6 13,5.1 C12.8,3.6 12.2,3 10.5,2.8 C12.2,2.6 12.8,2 13,0.5 Z"/>
        </StackPanel>
      </Border>
      <!-- Состояние режима текста: «Распознаю…», подсказка по клавишам, «Текст не найден» -->
      <Border x:Name="TextHint" Background="#E6202020" CornerRadius="6" Padding="10,5" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="TextHintText" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
      </Border>
      <!-- Режим текста: содержимое QR- или штрихкода по клику. Ссылка открывается только кнопкой «Открыть» -->
      <Border x:Name="CodePopup" Background="{DynamicResource Overlay.Panel}" CornerRadius="10" Padding="12,10" Visibility="Collapsed"
              BorderBrush="{DynamicResource Overlay.ShotRing}" BorderThickness="1" Width="340" Cursor="Arrow">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="CodeFormatText" Foreground="{DynamicResource Overlay.Ink70}" FontFamily="{DynamicResource Font.UI}" FontSize="11" Margin="0,0,0,6"/>
          <ScrollViewer x:Name="CodeScroll" MaxHeight="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <TextBlock x:Name="CodeText" Foreground="{DynamicResource Overlay.Ink}" FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                       TextWrapping="Wrap" LineHeight="18"/>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CodeOpenButton" Style="{StaticResource HudButton}" Content="{l:Loc Common.Open}" Click="OnCodeOpen"/>
            <Button x:Name="CodeCopyButton" Style="{StaticResource HudButton}" Content="{l:Loc Common.Copy}" Tag="Accent" Click="OnCodeCopy"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <local:MagnifierControl x:Name="Magnifier" IsHitTestVisible="False" Visibility="Collapsed"/>
      <!-- Поле ввода текстового инструмента; шрифт и размер совпадают с TextAnnotation -->
      <TextBox x:Name="TextEditor" Visibility="Collapsed" MinWidth="40" Padding="0" BorderThickness="1"
               BorderBrush="#AAFFFFFF" Background="#33000000" CaretBrush="White"
               FontFamily="Segoe UI" FontWeight="SemiBold" AcceptsReturn="True" Cursor="IBeam"/>
      <!-- Пипетка при выделении (C): «#3078F6 скопирован» у лупы -->
      <Border x:Name="PipetteBadge" Background="#F2292524" CornerRadius="6" Padding="8,3" Visibility="Collapsed" IsHitTestVisible="False"
              BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="PipetteBadgeChip" Width="11" Height="11" CornerRadius="2" BorderBrush="#88FFFFFF" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="PipetteBadgeText" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
        </StackPanel>
      </Border>
      <local:ToolbarControl x:Name="Toolbar" Visibility="Collapsed"/>
      <!-- Предупреждение о личных данных рядом с панелью. «Скрыть» пикселизирует найденное одним шагом undo; само ничего не скрывается -->
      <Border x:Name="PrivacyChip" Background="{DynamicResource Overlay.Panel}" CornerRadius="8" Padding="10,4,4,4" Visibility="Collapsed"
              BorderBrush="{DynamicResource Overlay.ShotRing}" BorderThickness="1" Cursor="Arrow">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Loc Privacy.Warning}" Foreground="{DynamicResource Overlay.Ink}" FontFamily="{DynamicResource Font.UI}" FontSize="12"
                     VerticalAlignment="Center"/>
          <Button x:Name="PrivacyHideButton" Style="{StaticResource HudButton}" Height="24" Margin="10,0,0,0" Tag="Accent"
                  Content="{l:Loc Privacy.Hide}" ToolTip="{l:Loc Privacy.HideTip}" Click="OnPrivacyHide"/>
          <Button Style="{StaticResource HudButton}" Height="24" Padding="8,0" Margin="4,0,0,0"
                  Content="✕" ToolTip="{l:Loc Privacy.Dismiss}" AutomationProperties.Name="{l:Loc Privacy.Dismiss}" Click="OnPrivacyDismiss"/>
        </StackPanel>
      </Border>
      <!-- Сюда добавляются flyout'ы параметров (OptionsFlyouts.Attach): поверх панели -->
    </Canvas>
  </Grid>
</Window>
