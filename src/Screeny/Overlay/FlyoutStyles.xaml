<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Стили содержимого всплывающих панелей параметров: всегда тёмные, как панель оверлея.
       Ключи StripButton, SwatchButton, Label и Separator ищет BeautifySection (SetResourceReference). -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>
  <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
    <Setter Property="Background" Value="{DynamicResource Overlay.Tooltip}"/>
    <Setter Property="Foreground" Value="{DynamicResource Overlay.Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Overlay.ShotRing}"/>
  </Style>
  <Style x:Key="StripButton" TargetType="ButtonBase">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource Overlay.Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinWidth" Value="26"/>
    <Setter Property="Padding" Value="5,0"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Overlay.Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Overlay.Pressed}"/></Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- «Нет» (⊘): нажата — часть выключена -->
  <Style x:Key="NoneButton" TargetType="ToggleButton" BasedOn="{StaticResource StripButton}">
    <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="Content" Value="⊘"/>
  </Style>
  <!-- Выравнивание текста: иконка Segoe Fluent, нажата — активное -->
  <Style x:Key="AlignButton" TargetType="ToggleButton" BasedOn="{StaticResource StripButton}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="26"/>
  </Style>
  <!-- Образец цвета: рамка подсвечена, когда образец активен (его красит палитра) -->
  <Style x:Key="SwatchButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Ring" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" Padding="2">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="{DynamicResource Overlay.Hover}"/></Trigger>
            <Trigger Property="Tag" Value="Active"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Подпись строки: колонка одной ширины, чтобы образцы и кнопки строк стояли друг под другом -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Overlay.Ink70}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="82"/>
    <Setter Property="Margin" Value="4,0,6,0"/>
  </Style>
  <!-- Строка flyout'а: подпись и кнопки; строки появляются поочерёдно при открытии -->
  <Style x:Key="Row" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style x:Key="Separator" TargetType="Rectangle">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Fill" Value="{DynamicResource Overlay.Divider}"/>
    <Setter Property="Margin" Value="6,0"/>
  </Style>
  <Style x:Key="ArrowIcon" TargetType="Path">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="Fill" Value="{DynamicResource Overlay.Ink}"/>
    <Setter Property="Stroke" Value="{DynamicResource Overlay.Ink}"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>
</ResourceDictionary>
