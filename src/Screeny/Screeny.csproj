<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Screeny</AssemblyName>
    <RootNamespace>Screeny</RootNamespace>
    <ApplicationIcon>Assets\screeny.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.3</Version>
    <!-- Own Main (Program.cs): VelopackApp.Build().Run() must run before WPF. -->
    <StartupObject>Screeny.Program</StartupObject>
    <Product>Screeny</Product>
    <Description>Снимки экрана с аннотациями</Description>
    <!-- UI strings: Localization/Strings.resx — English, other languages — satellite assemblies (Strings.ru.resx…). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <!-- Publishing: one Screeny.exe (requires .NET 10 Desktop Runtime). RID set in tools/publish.ps1,
       not here: RuntimeIdentifier in csproj changes normal build output path. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- QR/barcodes in text mode (Apache-2.0) -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- Precise recognition (MIT): only managed part of ONNX Runtime. Native onnxruntime.dll not in exe —
         it's in downloadable module (Modules/OcrModule.cs) same version 1.31.0. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="[1.31.0]" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <!-- Third-party license texts inside exe: next to Screeny.exe (in installer and portable build). -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
