<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Screeny</AssemblyName>
    <RootNamespace>Screeny</RootNamespace>
    <ApplicationIcon>Assets\screeny.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.2</Version>
    <!-- Свой Main (Program.cs): VelopackApp.Build().Run() должен выполниться раньше WPF. -->
    <StartupObject>Screeny.Program</StartupObject>
    <Product>Screeny</Product>
    <Description>Снимки экрана с аннотациями</Description>
    <!-- Строки интерфейса: Localization/Strings.resx — английский, остальные языки — сопутствующие сборки (Strings.ru.resx…). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <!-- Публикация: один Screeny.exe (нужен .NET 8 Desktop Runtime). RID задаётся в tools/publish.ps1,
       а не здесь: RuntimeIdentifier в csproj меняет путь вывода обычной сборки. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- QR и штрихкоды в режиме текста (Apache-2.0) -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- Точное распознавание (MIT): только управляемая часть ONNX Runtime. Нативная onnxruntime.dll не входит в exe —
         она в скачиваемом модуле (Modules/OcrModule.cs) той же версии 1.31.0. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="[1.31.0]" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <!-- Лицензии сторонних пакетов внутри exe: лежат рядом с Screeny.exe (и в установщике, и в портативной сборке). -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
