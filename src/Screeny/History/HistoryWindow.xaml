<t:ChromeWindow x:Class="Screeny.History.HistoryWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:l="clr-namespace:Screeny.Localization"
                xmlns:h="clr-namespace:Screeny.History"
                xmlns:t="clr-namespace:Screeny.Themes"
                Title="{l:Loc History.Title}" Width="920" Height="620" MinWidth="480" MinHeight="320"
                WindowStartupLocation="CenterScreen" Icon="/Assets/screeny.ico">
  <Window.Resources>
    <!-- Отдельный экземпляр меню на каждую карточку: обработчики подключаются, DataContext — карточки -->
    <ContextMenu x:Key="CardMenu" x:Shared="False">
      <MenuItem Header="{l:Loc History.Edit}" InputGestureText="E" Click="OnMenuEdit"/>
      <MenuItem Header="{l:Loc Common.Copy}" InputGestureText="Ctrl+C" Click="OnMenuCopy"/>
      <MenuItem Header="{l:Loc History.PinOnScreen}" Click="OnMenuPin" Visibility="{Binding CanPin, Converter={StaticResource BoolToVisibility}}"/>
      <MenuItem Header="{l:Loc Common.Open}" InputGestureText="Enter" Click="OnMenuOpen"/>
      <MenuItem Header="{l:Loc History.ShowInFolder}" Click="OnMenuShowInFolder"/>
      <Separator/>
      <MenuItem Header="{l:Loc Common.Delete}" InputGestureText="Del" Click="OnMenuDelete"/>
    </ContextMenu>
    <!-- Кнопки действий поверх миниатюры: на собственной подложке, чтобы читались на любом снимке -->
    <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Верхняя панель: счётчик и действия над всей историей -->
    <DockPanel DockPanel.Dock="Top" Margin="24,4,24,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{l:Loc History.OpenFolder}" Click="OnOpenFolder"/>
        <Button Content="{l:Loc History.ClearAll}" Margin="8,0,0,0" Style="{StaticResource DangerSubtleButton}" Click="OnClearAll"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock x:Name="Header" Style="{StaticResource Body}" Foreground="{DynamicResource Brush.Ink70}"/>
        <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" FontFamily="{DynamicResource Font.Mono}"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Поиск по распознанному тексту (Ctrl+F); без функции «Распознавание текста» его нет -->
    <Grid x:Name="SearchBar" DockPanel.Dock="Top" Margin="24,0,24,10" Width="360" HorizontalAlignment="Left" Visibility="Collapsed">
      <TextBox x:Name="SearchBox" Padding="30,0,32,0" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
               AutomationProperties.Name="{l:Loc History.SearchPlaceholder}"/>
      <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Margin="11,0,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink50}" IsHitTestVisible="False"/>
      <TextBlock x:Name="SearchPlaceholder" Text="{l:Loc History.SearchPlaceholder}" Style="{StaticResource Body}" Margin="31,0,32,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink50}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
      <Button x:Name="ClearSearch" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24"
              MinWidth="24" MinHeight="24" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False"
              ToolTip="{l:Loc History.ClearSearch}" Click="OnClearSearch" Visibility="Collapsed"/>
    </Grid>

    <Grid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
        <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" FontSize="15" Foreground="{DynamicResource Brush.Ink50}"
                   TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
      <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Padding="18,0,18,18"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
               KeyDown="OnItemsKeyDown">
        <ListBox.Template>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </ListBox.Template>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="{l:Loc History.CardTip}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="900"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnItemClick"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Card" Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="8"
                          BorderThickness="1" BorderBrush="{DynamicResource Brush.Stroke}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                      <Setter TargetName="Card" Property="RenderTransform">
                        <Setter.Value><TranslateTransform Y="-2"/></Setter.Value>
                      </Setter>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                      <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                      <Setter TargetName="Card" Property="Padding" Value="7"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ContextMenu" Value="{StaticResource CardMenu}"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type h:HistoryItemViewModel}">
            <StackPanel Width="200">
              <Grid Height="130">
                <Border CornerRadius="8" Background="{DynamicResource Brush.Thumb}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <!-- Действия появляются при наведении на карточку -->
                <Border x:Name="Actions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="2"
                        CornerRadius="8" Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Stroke}"
                        BorderThickness="1" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CardAction}" Content="&#xE70F;" ToolTip="{l:Loc History.Edit}" Click="OnMenuEdit"/>
                    <Button Style="{StaticResource CardAction}" Content="&#xE8C8;" ToolTip="{l:Loc Common.Copy}" Click="OnMenuCopy"/>
                    <Button Style="{StaticResource CardAction}" Content="&#xE718;" ToolTip="{l:Loc History.PinOnScreen}" Click="OnMenuPin"
                            Visibility="{Binding CanPin, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource CardAction}" Content="&#xE74D;" ToolTip="{l:Loc Common.Delete}" Click="OnMenuDelete"/>
                  </StackPanel>
                </Border>
                <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource Brush.Accent}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.OnAccent}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
              </Grid>
              <DockPanel Margin="2,8,2,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Mono}" Foreground="{DynamicResource Brush.Ink50}"/>
                <TextBlock Text="{Binding DateText}" Style="{StaticResource Mono}"/>
              </DockPanel>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding ForceActions}" Value="True">
                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</t:ChromeWindow>
