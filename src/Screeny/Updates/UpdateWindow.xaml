<t:ChromeWindow x:Class="Screeny.Updates.UpdateWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:l="clr-namespace:Screeny.Localization"
                xmlns:t="clr-namespace:Screeny.Themes"
                Title="{l:Loc Update.Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
                WindowStartupLocation="CenterScreen" Icon="/Assets/screeny.ico">
  <DockPanel>
    <!-- Нижняя панель: «Пропустить» слева, «Позже» и основное действие справа -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="24,16,24,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="LaterButton" IsCancel="True" MinWidth="96" Click="OnLater"/>
          <Button x:Name="UpdateButton" Content="{l:Loc Update.UpdateAndRestart}" IsDefault="True" MinWidth="112" Margin="8,0,0,0"
                  Style="{StaticResource AccentButton}" Click="OnUpdate"/>
        </StackPanel>
        <Button x:Name="SkipButton" Content="{l:Loc Update.SkipVersion}" HorizontalAlignment="Left" Click="OnSkip"/>
      </DockPanel>
    </Border>

    <StackPanel Margin="24,4,24,20">
      <TextBlock x:Name="HeadingText" Style="{StaticResource H1}" TextWrapping="Wrap"/>
      <TextBlock x:Name="CurrentText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

      <TextBlock Text="{l:Loc Update.WhatsNew}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8"/>
      <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
              CornerRadius="8">
        <ScrollViewer x:Name="NotesScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="NotesPanel" Margin="16,12,16,14"/>
        </ScrollViewer>
      </Border>

      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
  </DockPanel>
</t:ChromeWindow>
