<t:ChromeWindow x:Class="Screeny.Themes.DialogWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:l="clr-namespace:Screeny.Localization"
                xmlns:t="clr-namespace:Screeny.Themes"
                Title="Screeny" Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
                ShowCaptionTitle="False" WindowStartupLocation="CenterOwner" Icon="/Assets/screeny.ico">
  <StackPanel Margin="24,4,24,20">
    <TextBlock x:Name="HeadingText" Style="{StaticResource H1}" TextWrapping="Wrap"/>
    <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Foreground="{DynamicResource Brush.Ink70}"
               TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CancelButton" Content="{l:Loc Common.Cancel}" MinWidth="96" IsCancel="True" Click="OnCancel"/>
      <Button x:Name="ConfirmButton" Content="{l:Loc Common.OK}" MinWidth="96" Margin="8,0,0,0" IsDefault="True"
              Style="{StaticResource AccentButton}" Click="OnConfirm"/>
    </StackPanel>
  </StackPanel>
</t:ChromeWindow>
