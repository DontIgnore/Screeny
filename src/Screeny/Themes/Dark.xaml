<!-- Тёмная палитра. Ключи совпадают с Light.xaml: ThemeManager подменяет словарь целиком,
     а стили в Theme.xaml ссылаются на кисти через DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Обводка окна DWM (Windows 11): фон + 10 % текста, без альфы -->
  <Color x:Key="Color.WindowBorder">#FF3E3A38</Color>

  <SolidColorBrush x:Key="Brush.Bg" Color="#FF292524"/>
  <SolidColorBrush x:Key="Brush.Ink" Color="#FFFFF7ED"/>
  <SolidColorBrush x:Key="Brush.Ink70" Color="#B3FFF7ED"/>
  <SolidColorBrush x:Key="Brush.Ink50" Color="#80FFF7ED"/>
  <SolidColorBrush x:Key="Brush.Ink20" Color="#33FFF7ED"/>
  <SolidColorBrush x:Key="Brush.Ink10" Color="#1AFFF7ED"/>
  <SolidColorBrush x:Key="Brush.Ink05" Color="#0DFFF7ED"/>
  <SolidColorBrush x:Key="Brush.Card" Color="#0DFFF7ED"/>
  <SolidColorBrush x:Key="Brush.CardHover" Color="#1AFFF7ED"/>
  <SolidColorBrush x:Key="Brush.CardPressed" Color="#24FFF7ED"/>
  <SolidColorBrush x:Key="Brush.Stroke" Color="#1AFFF7ED"/>
  <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#33FFF7ED"/>
  <!-- Всплывающие панели (меню, подсказки) непрозрачны: под ними может быть что угодно -->
  <SolidColorBrush x:Key="Brush.Popup" Color="#FF332F2D"/>
  <SolidColorBrush x:Key="Brush.Thumb" Color="#FF211E1D"/>
  <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#26FF3B30"/>
  <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFF6B61"/>
</ResourceDictionary>
