<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Screeny UI languages (see Localization/Loc.cs); satellite package assemblies are only for these languages. -->
    <SatelliteResourceLanguages>en;ru;es;zh-Hans;ja</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
